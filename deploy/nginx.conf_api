# Diletakkan di /home/arcandapp/conf/web/monopoli.arcand.my.id/ sebagai nginx.conf_api dan nginx.ssl.conf_api.
# Meneruskan /api/ai (otak komputer mode Lawan Komputer, lihat server/ai.js) ke server Node lokal.
location = /api/ai {
    proxy_pass http://127.0.0.1:3077;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;   # dipakai server untuk batas per alamat IP
    proxy_read_timeout 30s;
    client_max_body_size 8k;
}
